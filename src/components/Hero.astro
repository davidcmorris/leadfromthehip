---
interface CTA {
	label: string;
	href: string;
}
interface Props {
	eyebrow: string;
	standfirst: string;
	standfirstPlaceholder?: boolean;
	primaryCta?: CTA;
	secondaryCta?: CTA;
}
const { eyebrow, standfirst, standfirstPlaceholder = false, primaryCta, secondaryCta } = Astro.props;
---
<section class="max-w-[1080px] mx-auto px-6 pt-16 pb-12">
	<p class="eyebrow text-brass mb-4">{eyebrow}</p>
	<h1 class="hero-h1 mb-6">
		<slot />
	</h1>
	<p class:list={["measure text-lg mb-8", standfirstPlaceholder ? "placeholder" : "text-muted"]}>
		{standfirst}
	</p>
	{(primaryCta || secondaryCta) && (
		<div class="flex flex-wrap gap-4">
			{primaryCta && (
				<a
					href={primaryCta.href}
					class="bg-petrol text-paper px-5 py-3 rounded-[3px] font-medium hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-petrol"
				>
					{primaryCta.label}
				</a>
			)}
			{secondaryCta && (
				<a
					href={secondaryCta.href}
					class="border border-rule-strong text-ink px-5 py-3 rounded-[3px] font-medium hover:border-petrol hover:text-petrol focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-petrol"
				>
					{secondaryCta.label}
				</a>
			)}
		</div>
	)}
</section>
