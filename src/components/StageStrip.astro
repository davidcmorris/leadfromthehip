---
const stages = [
	{
		number: "01",
		name: "Study",
		body: "Understanding what you're working with — the pattern itself, the behavior science behind why it's hard to change, and what acting well actually looks like with the people around you. This is where the reading happens. Necessary, and completely inert on its own.",
		question: "What do you actually understand, and what have you only read about?",
	},
	{
		number: "02",
		name: "Practice",
		body: "Two or three specific reps — each with a cue, a fixed slot, and a script — run in conditions low-stakes enough that getting it wrong costs nothing. This is where the script stops being words on a page and starts being something you can actually do.",
		question: "Can you run it when nothing is on the line?",
	},
	{
		number: "03",
		name: "Hard training",
		body: "The same rep, run for real — a real deadline, a real conflict, a real bad Thursday. This is the only place a habit actually gets proven, and almost nobody trains for it on purpose. Ninety days in, the people around you can tell you whether it held.",
		question: "Can you still run it when something is on the line?",
	},
];
---
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
	{stages.map((s) => (
		<div class="bg-surface border border-rule rounded-[3px] p-5 flex flex-col gap-2">
			<p class="eyebrow text-brass">{s.number} · {s.name}</p>
			<p class="text-ink text-sm">{s.body}</p>
			<p class="pull-quote text-muted text-sm mt-auto">{s.question}</p>
		</div>
	))}
</div>
