---
const stages = [
	{
		number: "01",
		name: "Study/Learn",
		body: "The pattern itself, why it's hard to change, what acting well actually looks like. This is where the reading happens — necessary, and inert on its own.",
		question: "What do you actually understand, and what have you only read about?",
	},
	{
		number: "02",
		name: "Practice",
		body: "Two or three reps, each with a cue — run low-stakes enough that getting it wrong costs nothing. This is where it stops being an idea and becomes something you can actually do.",
		question: "Can you run it when nothing is on the line?",
	},
	{
		number: "03",
		name: "Hard training",
		body: "The same rep, run for real — a real deadline, a real conflict, a real bad Thursday. The only place a habit gets proven, and almost nobody trains for it on purpose. Ninety days in, the people around you can tell you whether it held.",
		question: "Can you still run it when something is on the line?",
	},
];
---
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
	{stages.map((s) => (
		<div class="bg-surface border border-rule rounded-[3px] p-5 flex flex-col gap-2">
			<p class="eyebrow text-brass">{s.number} · {s.name}</p>
			<p class="text-ink text-sm">{s.body}</p>
			<p class="pull-quote text-muted text-sm mt-auto">{s.question}</p>
		</div>
	))}
</div>
