---
const stages = [
	{
		number: "01",
		name: "Terrain",
		body: "Your stable dispositions, read properly. Not a label and not a type — a map of where routines will come cheap to you and where they will always cost.",
		question: "What comes free to you, and what never will?",
	},
	{
		number: "02",
		name: "Load",
		body: "What this role, this team, and this moment are actually asking of you. Terrain barely moves. Load changes with every promotion and reorg.",
		question: "What is this job demanding right now?",
	},
	{
		number: "03",
		name: "Route",
		body: "Two or three routines with a named cue, a fixed slot, and a script — designed to work with your terrain rather than against it. The cue and the slot do the noticing and the deciding in advance, so on a bad day the only thing left to do is run the script. Not more discipline. Better scaffolding.",
		question: "What runs on Tuesday at nine without willpower?",
	},
	{
		number: "04",
		name: "Evidence",
		body: "Ninety days later, the behavior gets re-measured by the people who work for you. Not the personality — the behavior. Dated, scored, compared to where you started.",
		question: "Did anything actually change?",
	},
];
---
<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
	{stages.map((s) => (
		<div class="bg-surface border border-rule rounded-[3px] p-5 flex flex-col gap-2">
			<p class="eyebrow text-brass">{s.number} · {s.name}</p>
			<p class="text-ink text-sm">{s.body}</p>
			<p class="pull-quote text-muted text-sm mt-auto">{s.question}</p>
		</div>
	))}
</div>
