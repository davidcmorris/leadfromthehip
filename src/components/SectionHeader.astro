---
interface Props {
	exercise?: string;
	title: string;
	lede?: string;
}
const { exercise, title, lede } = Astro.props;
---
<div class="mb-8">
	{exercise && (
		<div class="flex items-baseline gap-3 mb-3">
			<span class="font-display text-5xl md:text-6xl leading-none text-petrol tabular-nums">
				{exercise}
			</span>
			<span class="eyebrow text-muted">Exercise</span>
		</div>
	)}
	<h2 class="text-2xl md:text-3xl mb-2">{title}</h2>
	{lede && <p class="text-muted measure">{lede}</p>}
</div>
