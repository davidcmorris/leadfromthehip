---
interface Props {
	number: string;
	title: string;
	lede?: string;
}
const { number, title, lede } = Astro.props;
---
<div class="mb-8">
	<span class="eyebrow inline-block bg-brass-soft text-brass px-2 py-1 rounded-[3px] mb-3">
		{number}
	</span>
	<h2 class="text-2xl md:text-3xl mb-2">{title}</h2>
	{lede && <p class="text-muted measure">{lede}</p>}
</div>
