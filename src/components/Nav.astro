---
import Logo from "./Logo.astro";

interface Props {
	currentPath?: string;
}
const { currentPath = "" } = Astro.props;

const links = [
	{ href: "/", label: "Home" },
	{ href: "/work-with-me", label: "Work with me" },
	{ href: "/about", label: "About" },
];
---
<header class="border-b border-rule">
	<nav class="max-w-[1080px] mx-auto px-6 py-4 flex items-center justify-between gap-4 flex-wrap">
		<a
			href="/"
			class="flex items-center gap-2 text-ink no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-petrol rounded-sm"
		>
			<Logo class="w-7 h-6 text-petrol" />
			<span class="font-semibold tracking-tight">Lead From The Hip</span>
		</a>
		<ul class="flex items-center gap-6 flex-wrap">
			{links.map((link) => (
				<li>
					<a
						href={link.href}
						aria-current={currentPath === link.href ? "page" : undefined}
						class:list={[
							"text-sm font-medium hover:text-petrol focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-petrol rounded-sm",
							currentPath === link.href ? "text-petrol" : "text-ink",
						]}
					>
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>
